# =============================================================================
# SLMS — Root Environment Variables
# Copy this to .env and fill in values.
# This file is read by Docker Compose for all services.
# Backend-specific .env is at backend/.env (symlinked or copied from this).
# =============================================================================

# ---- Application ----
APP_KEY=base64:CHANGE_ME_RUN_php_artisan_key_generate

# ---- Database ----
DB_DATABASE=slms
DB_USERNAME=slms
DB_PASSWORD=secret

# ---- Redis ----
REDIS_PASSWORD=

# ---- MinIO ----
MINIO_ROOT_USER=slmsadmin
MINIO_ROOT_PASSWORD=slmspassword
MINIO_BUCKET=slms

# ---- Laravel Reverb ----
REVERB_APP_ID=slms
REVERB_APP_KEY=slmskey
REVERB_APP_SECRET=slmssecret
