# =============================================================================
# SLMS — Root .gitignore
# =============================================================================

# Environment files — never commit secrets
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.idea/
.vscode/
*.iml

# Docker overrides (local dev customizations)
docker-compose.override.yml

# Logs
*.log
